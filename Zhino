<!DOCTYPE html>
<html lang="ckb" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#120918">

  <title>ڕۆژی لەدایکبوونی ژینۆ</title>

  <!-- فۆنتە جوانە کوردییەکان -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@300;400;500;600;700;800;900&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <style>
    :root {
      --ink: #fff8ec;
      --muted: #d8c8d7;
      --rose: #ff91ad;
      --rose-dark: #ff4f82;
      --gold: #f4d58d;
      --night: #0c0611;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--night);
      overflow-x: hidden;
      font-family: "Noto Kufi Arabic", Tahoma, sans-serif;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -3;
      background:
        radial-gradient(circle at 12% 8%, #521934 0, transparent 29%),
        radial-gradient(circle at 88% 25%, #301d55 0, transparent 32%),
        linear-gradient(145deg, #08040c, #1a0a1b 48%, #08040c);
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      opacity: 0.22;
      pointer-events: none;

      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
    }

    .progress {
      position: fixed;
      top: 0;
      right: 0;
      width: 0;
      height: 3px;
      z-index: 100;
      background: linear-gradient(90deg, var(--rose-dark), var(--gold));
      box-shadow: 0 0 18px var(--rose);
    }

    .nav {
      position: fixed;
      top: 18px;
      left: 18px;
      right: 18px;
      z-index: 30;

      display: flex;
      align-items: center;
      justify-content: space-between;

      pointer-events: none;
    }

    .brand,
    .sound {
      color: var(--ink);
      pointer-events: auto;

      border: 1px solid rgba(244, 213, 141, 0.25);
      background: rgba(16, 8, 20, 0.58);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);

      border-radius: 999px;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    }

    .brand {
      padding: 9px 16px;
      font-size: 12px;
    }

    .sound {
      width: 45px;
      height: 45px;
      cursor: pointer;
      font-size: 18px;
      transition: 0.3s;
    }

    .sound:hover {
      transform: scale(1.08);
      border-color: var(--gold);
    }

    .hero {
      min-height: 100svh;
      position: relative;
      isolation: isolate;

      display: grid;
      place-items: center;

      padding: 100px 22px 50px;
      text-align: center;
    }

    .halo {
      position: absolute;
      z-index: -1;

      width: min(78vw, 720px);
      aspect-ratio: 1;
      border-radius: 50%;

      background:
        radial-gradient(
          circle,
          rgba(255, 111, 152, 0.17),
          rgba(130, 71, 161, 0.05) 46%,
          transparent 69%
        );

      animation: breathe 5s ease-in-out infinite;
    }

    .eyebrow {
      margin: 0 0 22px;
      color: var(--gold);
      font-size: clamp(12px, 2vw, 15px);
      letter-spacing: 0.1em;

      opacity: 0;
      animation: rise 0.9s 0.15s forwards;
    }

    .hero h1 {
      margin: 0;
      line-height: 0.9;

      font-size: clamp(54px, 14vw, 150px);
      font-weight: 900;
      letter-spacing: -0.065em;

      color: transparent;
      background: linear-gradient(
        180deg,
        #fffdf5 15%,
        #f8d79a 62%,
        #c88b52
      );

      -webkit-background-clip: text;
      background-clip: text;

      filter: drop-shadow(0 14px 28px rgba(0, 0, 0, 0.55));

      opacity: 0;
      animation: rise 1.1s 0.35s forwards;
    }

    .hero h1 span {
      display: block;
      margin-bottom: 18px;

      color: var(--rose);
      -webkit-text-fill-color: var(--rose);

      font-size: 0.24em;
      font-weight: 500;
      letter-spacing: 0.04em;
    }

    .date {
      display: inline-flex;
      align-items: center;
      gap: 13px;

      margin: 30px 0 18px;
      color: var(--muted);

      opacity: 0;
      animation: rise 1s 0.65s forwards;
    }

    .date i {
      width: 44px;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold));
    }

    .date i:last-child {
      transform: rotate(180deg);
    }

    .intro {
      max-width: 670px;
      margin: auto;

      color: #eee0eb;
      font-family: "Noto Naskh Arabic", serif;
      font-size: clamp(18px, 2.5vw, 23px);
      line-height: 2.15;

      opacity: 0;
      animation: rise 1s 0.8s forwards;
    }

    .scroll {
      margin-top: 38px;
      color: #c9a8bd;
      font-size: 12px;
      animation: floating 2s infinite;
    }

    .scroll b {
      display: block;
      font-size: 25px;
    }

    .petal {
      position: fixed;
      top: -12vh;
      z-index: 12;

      color: var(--rose);
      pointer-events: none;

      filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.35));
      animation: falling linear forwards;
    }

    .section {
      position: relative;
      max-width: 1060px;
      margin: auto;
      padding: 100px 24px;
    }

    .kicker {
      color: var(--rose);
      font-size: 13px;
      letter-spacing: 0.1em;
    }

    .title {
      margin: 8px 0 45px;
      line-height: 1.25;

      font-size: clamp(33px, 6vw, 66px);
      font-weight: 800;
      letter-spacing: -0.035em;
    }

    .glass {
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 32px;

      background:
        linear-gradient(
          145deg,
          rgba(255, 255, 255, 0.1),
          rgba(255, 255, 255, 0.025)
        );

      box-shadow:
        0 30px 90px rgba(0, 0, 0, 0.45),
        inset 0 1px rgba(255, 255, 255, 0.1);

      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .letter {
      position: relative;
      overflow: hidden;
      padding: clamp(28px, 6vw, 72px);
    }

    .letter::before {
      content: "“";
      position: absolute;
      top: -35px;
      left: 28px;

      color: rgba(244, 213, 141, 0.08);
      font-family: Georgia, serif;
      font-size: 190px;
    }

    .letter p {
      margin: 0 0 24px;

      color: #eee5ed;
      font-family: "Noto Naskh Arabic", serif;
      font-size: clamp(18px, 2.5vw, 23px);
      line-height: 2.25;
    }

    .signature {
      margin-top: 38px !important;
      color: var(--gold) !important;
      text-align: left;
      font-weight: 700;
    }

    .signature span {
      display: block;
      color: var(--muted);
      font-family: "Noto Kufi Arabic", sans-serif;
      font-size: 13px;
      font-weight: 400;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      min-height: 240px;
      padding: 32px 24px;

      display: flex;
      flex-direction: column;
      justify-content: space-between;

      transition: 0.45s;
    }

    .card:hover {
      transform: translateY(-8px);
      border-color: rgba(244, 213, 141, 0.45);
    }

    .num {
      color: var(--gold);
      opacity: 0.8;

      font-family: Georgia, serif;
      font-size: 42px;
      font-style: italic;
    }

    .card h3 {
      margin: 14px 0 9px;
      font-size: 21px;
    }

    .card p {
      margin: 0;
      color: var(--muted);
      font-family: "Noto Naskh Arabic", serif;
      font-size: 18px;
      line-height: 1.9;
    }

    .age-wrap {
      text-align: center;
    }

    .age {
      color: transparent;
      line-height: 0.85;

      font-size: clamp(92px, 22vw, 210px);
      font-weight: 900;

      background: linear-gradient(135deg, var(--rose), var(--gold));
      -webkit-background-clip: text;
      background-clip: text;

      filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
    }

    .age-label {
      margin-top: 24px;
      color: var(--muted);
      font-size: 18px;
    }

    .age-note {
      max-width: 620px;
      margin: 26px auto;

      color: #e7d9e4;
      font-family: "Noto Naskh Arabic", serif;
      font-size: 20px;
      line-height: 2;
    }

    .wish {
      padding-bottom: 150px;
      text-align: center;
    }

    .gift {
      width: 110px;
      height: 110px;
      margin: 0 auto 28px;

      display: grid;
      place-items: center;

      cursor: pointer;
      font-size: 45px;

      border: 1px solid rgba(244, 213, 141, 0.42);
      border-radius: 50%;

      background: radial-gradient(circle, #4a1830, #160a18);

      box-shadow:
        0 0 0 12px rgba(255, 255, 255, 0.025),
        0 25px 65px rgba(0, 0, 0, 0.45);

      animation: pulse 2.2s infinite;
      transition: 0.4s;
    }

    .gift:hover {
      transform: rotate(-7deg) scale(1.08);
    }

    .reveal {
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transform: translateY(24px);

      transition:
        max-height 1.2s ease,
        opacity 1s,
        transform 1s;
    }

    .reveal.open {
      max-height: 700px;
      opacity: 1;
      transform: none;
    }

    .reveal h2 {
      margin: 14px 0;

      color: var(--gold);
      font-size: clamp(38px, 8vw, 82px);
    }

    .reveal p {
      max-width: 700px;
      margin: auto;

      color: #eee0e9;
      font-family: "Noto Naskh Arabic", serif;
      font-size: 21px;
      line-height: 2.2;
    }

    footer {
      padding: 28px;
      color: #a98b9e;
      text-align: center;
      font-size: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .spark {
      position: fixed;
      z-index: 100;

      pointer-events: none;
      font-size: 20px;

      animation: burst 1.3s ease-out forwards;
    }

    .reveal-on-scroll {
      opacity: 0;
      transform: translateY(35px);
      transition: 1s ease;
    }

    .reveal-on-scroll.seen {
      opacity: 1;
      transform: none;
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(30px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes breathe {
      50% {
        transform: scale(1.13);
        opacity: 0.72;
      }
    }

    @keyframes floating {
      50% {
        transform: translateY(8px);
      }
    }

    @keyframes pulse {
      50% {
        box-shadow:
          0 0 0 22px rgba(255, 145, 173, 0.04),
          0 25px 65px rgba(0, 0, 0, 0.45);
      }
    }

    @keyframes falling {
      to {
        transform:
          translate3d(var(--drift), 115vh, 0)
          rotate(680deg);

        opacity: 0.1;
      }
    }

    @keyframes burst {
      to {
        transform:
          translate(var(--x), var(--y))
          rotate(220deg)
          scale(0.2);

        opacity: 0;
      }
    }

    @media (max-width: 760px) {
      .cards {
        grid-template-columns: 1fr;
      }

      .card {
        min-height: 190px;
      }

      .section {
        padding: 76px 18px;
      }

      .nav {
        top: 12px;
        left: 12px;
        right: 12px;
      }

      .hero {
        padding-top: 90px;
      }

      .letter {
        border-radius: 24px;
      }

      .brand {
        font-size: 10px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        scroll-behavior: auto !important;
      }

      .reveal-on-scroll {
        opacity: 1;
        transform: none;
      }
    }
  </style>
</head>

<body>

  <div class="progress" id="progress"></div>

  <nav class="nav">
    <div class="brand">لە ساکانەوە، بۆ ژینۆ ♡</div>

    <button
      class="sound"
      id="sound"
      aria-label="کردنەوەی مۆسیقا"
    >
      ♫
    </button>
  </nav>

  <header class="hero">
    <div class="halo"></div>

    <div>
      <p class="eyebrow">
        ئەمڕۆ، جیهان جوانترە چونکە تۆی تێدای
      </p>

      <h1>
        <span>ڕۆژی لەدایکبوونت پیرۆز</span>
        ژینۆ
      </h1>

      <div class="date">
        <i></i>
        <strong>١٨ · ٨ · ٢٠٠٤</strong>
        <i></i>
      </div>

      <p class="intro">
        ئەم پەڕەیە تەنها وێبسایتێک نییە؛
        کۆمەڵێک وشەیە کە دڵم ویستی بە جوانترین شێوە بگاتە دڵت.
      </p>

      <div class="scroll">
        بۆ خوارەوە بڕۆ
        <b>⌄</b>
      </div>
    </div>
  </header>

  <section class="section reveal-on-scroll">
    <p class="kicker">نامەیەک لە دڵەوە</p>

    <h2 class="title">ژینۆی ئازیز،</h2>

    <article class="glass letter">
      <p>
        لە ڕۆژێکی وەک ئەمڕۆدا، مرۆڤێکی جوان هاتە ئەم جیهانە؛
        مرۆڤێک کە بوونی بۆ خۆی چیرۆکێکە لە میهرەبانی،
        جوانی و هیوا.
      </p>

      <p>
        دەمەوێت بزانیت کە تۆ تەنها ساڵێکی ترت زیاد نەکردووە؛
        بەڵکوو ساڵێکی ترت پڕ کردووە لە یادەوەری،
        پێکەنین، خەون و هەستە جوانەکان.
        هەر پێکەنینێکت ڕۆشناییەکە و
        هەر قسەیەکت نیشانەی دڵێکی پاکە.
      </p>

      <p>
        لە خوا دەخوازم ئەم ساڵەی نوێی تەمەنت
        ببێتە دەستپێکی جوانترین بەشی ژیانت؛
        ساڵێک کە خەونەکانت یەک بە یەک ببنە ڕاستی،
        دڵت ئارام بێت و پێکەنین لەسەر لێوەکانت
        هەرگیز کەم نەبێتەوە.
      </p>

      <p class="signature">
        بە هەموو ڕێز و خۆشەویستییەوە — ساکان

        <span>
          ئەو هاوڕێیەی کە بە بوونت دڵخۆشە
        </span>
      </p>
    </article>
  </section>

  <section class="section reveal-on-scroll">
    <p class="kicker">سێ ئاوات بۆ تۆ</p>

    <h2 class="title">
      بۆ ساڵێکی پڕ لە ڕووناکی
    </h2>

    <div class="cards">

      <article class="glass card">
        <span class="num">١</span>

        <div>
          <h3>دڵێکی ئارام</h3>

          <p>
            هیچ شتێک نەبێتە هۆی ئەوەی
            ئارامیی دڵت لێ بسەنێتەوە.
          </p>
        </div>
      </article>

      <article class="glass card">
        <span class="num">٢</span>

        <div>
          <h3>خەونی بەدی‌هاتوو</h3>

          <p>
            هەرچی خەون و ئامانجت هەیە،
            بە جوانترین شێوە ببێتە ڕاستی.
          </p>
        </div>
      </article>

      <article class="glass card">
        <span class="num">٣</span>

        <div>
          <h3>پێکەنینی هەمیشەیی</h3>

          <p>
            پێکەنینە جوانەکەت هەمیشە
            لەسەر لێوەکانت بمێنێتەوە.
          </p>
        </div>
      </article>

    </div>
  </section>

  <section class="section age-wrap reveal-on-scroll">
    <p class="kicker">
      بەهاری بیست‌ودووەم
    </p>

    <div class="age">٢٢</div>

    <div class="age-label">
      ساڵ لە جوانی، هیوا و یادەوەری
    </div>

    <p class="age-note">
      لە ١٨ی ئابی ٢٠٠٤ەوە تا ئەمڕۆ،
      هەر ساڵێک لاپەڕەیەکی جوانی چیرۆکی تۆ بووە؛
      بەڵام دڵنیام جوانترین لاپەڕەکان
      هێشتا نەنووسراون.
    </p>
  </section>

  <section class="section wish reveal-on-scroll">
    <p class="kicker">کۆتا سوپرایز</p>

    <h2 class="title">
      کلیک لە دیارییەکە بکە
    </h2>

    <button
      class="gift"
      id="gift"
      aria-label="کردنەوەی دیاری"
    >
      🎁
    </button>

    <div class="reveal" id="reveal">
      <h2>
        ژینۆ، ڕۆژت پیرۆز! ✨
      </h2>

      <p>
        هیوادارم ئەم ڕۆژە بە قەدەر دڵت جوان،
        بە قەدەر پێکەنینت شیرین و
        بە قەدەر خەونەکانت گەورە بێت.
        تۆ شایستەی هەموو جوانییەکانی ئەم جیهانەیت.
      </p>
    </div>
  </section>

  <footer>
    بە خۆشەویستییەوە دروستکراوە لەلایەن ساکان ♡ ٢٠٢٦
  </footer>

  <script>
    const $ = (selector) => document.querySelector(selector);

    /* نیشاندانی ئاستی سکرۆڵ */
    window.addEventListener("scroll", () => {
      const page = document.documentElement;

      const percentage =
        page.scrollTop /
        (page.scrollHeight - page.clientHeight) *
        100;

      $("#progress").style.width = percentage + "%";
    });

    /* دەرکەوتنی بەشەکان لە کاتی سکرۆڵ */
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("seen");
          }
        });
      },
      {
        threshold: 0.13
      }
    );

    document
      .querySelectorAll(".reveal-on-scroll")
      .forEach((element) => observer.observe(element));

    /* دڵ و گوڵە جووڵاوەکان */
    function createPetal() {
      const element = document.createElement("span");

      element.className = "petal";

      const shapes = ["♥️", "✦", "✿", "❀"];

      element.textContent =
        shapes[Math.floor(Math.random() * shapes.length)];

      element.style.left =
        Math.random() * 100 + "vw";

      element.style.fontSize =
        10 + Math.random() * 16 + "px";

      element.style.opacity =
        0.25 + Math.random() * 0.55;

      element.style.setProperty(
        "--drift",
        Math.random() * 180 - 90 + "px"
      );

      element.style.animationDuration =
        7 + Math.random() * 8 + "s";

      document.body.appendChild(element);

      setTimeout(() => {
        element.remove();
      }, 16000);
    }

    setInterval(createPetal, 650);

    /* سوپرایزی دیارییەکە */
    $("#gift").addEventListener("click", (event) => {
      const reveal = $("#reveal");

      reveal.classList.add("open");
      event.currentTarget.textContent = "💝";

      for (let i = 0; i < 38; i++) {
        const spark = document.createElement("i");

        spark.className = "spark";

        const shapes = ["♥️", "✦", "✧", "❀"];
        spark.textContent = shapes[i % shapes.length];

        spark.style.left = event.clientX + "px";
        spark.style.top = event.clientY + "px";

        spark.style.color =
          i % 2 ? "#f4d58d" : "#ff91ad";

        spark.style.setProperty(
          "--x",
          Math.random() * 360 - 180 + "px"
        );

        spark.style.setProperty(
          "--y",
          Math.random() * -300 + 80 + "px"
        );

        document.body.appendChild(spark);

        setTimeout(() => {
          spark.remove();
        }, 1400);
      }

      setTimeout(() => {
        reveal.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });
      }, 250);
    });

    /* مۆسیقای ئارام */
    let audioContext;
    let playing = false;

    $("#sound").addEventListener("click", () => {
      if (!audioContext) {
        const AudioContext =
          window.AudioContext || window.webkitAudioContext;

        audioContext = new AudioContext();

        const master = audioContext.createGain();

        master.gain.value = 0.035;
        master.connect(audioContext.destination);

        const notes = [
          261.63,
          329.63,
          392,
          523.25
        ];

        notes.forEach((frequency, index) => {
          const oscillator =
            audioContext.createOscillator();

          const gain =
            audioContext.createGain();

          oscillator.type = "sine";
          oscillator.frequency.value = frequency;
          gain.gain.value = 0.18 / (index + 1);

          oscillator.connect(gain);
          gain.connect(master);
          oscillator.start();
        });
      }

      playing = !playing;

      if (playing) {
        audioContext.resume();
        $("#sound").textContent = "♪";
      } else {
        audioContext.suspend();
        $("#sound").textContent = "♫";
      }
    });
  </script>

</body>
</html>
